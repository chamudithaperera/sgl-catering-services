generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  username     String   @unique
  name         String
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("admins")
}

model Message {
  id           Int      @id @default(autoincrement())
  customerName String   @map("customer_name")
  phone        String
  eventType    String   @map("event_type")
  message      String   @db.Text
  isRead       Boolean  @default(false) @map("is_read")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("messages")
}

model ContactDetails {
  id             Int      @id
  phone          String
  whatsapp       String
  secondaryPhone String   @default("") @map("secondary_phone")
  tertiaryPhone  String   @default("") @map("tertiary_phone")
  email          String
  address        String
  businessHours  String   @map("business_hours")
  mapUrl         String   @map("map_url") @db.Text
  facebookUrl    String   @map("facebook_url")
  instagramUrl   String   @map("instagram_url")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("contact_details")
}

model CateringMenu {
  id            Int      @id @default(autoincrement())
  name          String
  priceLabel    String   @map("price_label")
  includedItems Json     @map("included_items")
  featured      Boolean  @default(false)
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("catering_menus")
}

model RentalItem {
  id         Int      @id @default(autoincrement())
  name       String
  category   String
  imageUrl   String   @map("image_url")
  priceLabel String   @map("price_label")
  details    String   @default("")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("rental_items")
}

model Gallery {
  id        Int      @id @default(autoincrement())
  title     String
  imageUrl  String   @map("image_url")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("gallery")
}

model WebImage {
  id        Int      @id @default(autoincrement())
  imageKey  String   @map("image_key")
  title     String
  imageUrl  String   @map("image_url")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([imageKey])
  @@map("web_images")
}

model WebText {
  id                 Int      @id @default(autoincrement())
  textKey            String   @unique @map("text_key")
  titleSinhala       String   @map("title_sinhala")
  titleEnglish       String   @map("title_english")
  descriptionSinhala String   @map("description_sinhala") @db.Text
  descriptionEnglish String   @map("description_english") @db.Text
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("web_texts")
}

model Review {
  id           Int      @id @default(autoincrement())
  customerName String   @map("customer_name")
  eventType    String   @map("event_type")
  rating       Int
  quote        String   @db.Text
  isApproved   Boolean  @default(true) @map("is_approved")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("reviews")
}
